# Optional override for the public newsletter configured in @0xhq/config/links.
# Without this variable, the site subscribes to https://buttondown.com/0xhq.
# Set an empty value to hide the signup section. No API key is required.
BUTTONDOWN_USERNAME=0xhq

# Public canonical origin used by article metadata, structured data, and sitemaps.
# Keep this set to the production domain, including for preview builds.
SITE_URL=https://0xhq.space
