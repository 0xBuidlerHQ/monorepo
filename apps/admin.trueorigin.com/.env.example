# Optional destination for the "Open app" link.
# Defaults to localhost:3001 in development and app.trueorigin.com in production.
# TRUEORIGIN_APP_URL=https://app.trueorigin.com

# Public gateway used to display ipfs:// images and metadata.
NEXT_PUBLIC_IPFS_GATEWAY_URL=http://localhost:3003/ipfs/

# Server-only upload endpoint for future intake/inspection actions.
IPFS_API_URL=http://localhost:3003

# Shared submissions API (server-only).
API_URL=http://localhost:3004
# Development automatically reads services/api/.data/service-keys.json.
# Production: configure this app’s matching service secret.
# API_ADMIN_SECRET=
# ADMIN_ORIGIN=https://admin.trueorigin.com
