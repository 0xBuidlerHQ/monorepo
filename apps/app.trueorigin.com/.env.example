# Copy to .env.local for app-specific development settings.
PASSKEY_ORIGIN=http://localhost:3001
PASSKEY_RP_ID=localhost

# Optional. Defaults to this app's .data/passkeys.sqlite locally.
# Production requires an absolute path on a persistent volume.
# PASSKEY_DB_PATH=/persistent-volume/passkeys.sqlite

# For a local HTTPS domain, set both origin and RP ID to match it.
# PASSKEY_ORIGIN=https://trueorigin.dev
# PASSKEY_RP_ID=trueorigin.dev
# localhost, trueorigin.dev and app.trueorigin.com have separate credentials.

# Production (server-only; never prefix these with NEXT_PUBLIC_):
# TRUEORIGIN_CHAIN_ID=1
# PASSKEY_ORIGIN=https://app.trueorigin.com
# PASSKEY_RP_ID=app.trueorigin.com
# ETHEREUM_RPC_URL=https://YOUR_ETHEREUM_MAINNET_RPC
# ZERODEV_BUNDLER_RPC_URL=https://rpc.zerodev.app/api/v3/YOUR_PROJECT_ID/chain/1

# Public gateway used to display ipfs:// images and metadata.
NEXT_PUBLIC_IPFS_GATEWAY_URL=http://localhost:3003/ipfs/

# Shared submissions API (server-only).
API_URL=http://localhost:3004
# Development automatically reads services/api/.data/service-keys.json.
# Production: configure this app’s matching service secret.
# API_CUSTOMER_SECRET=
