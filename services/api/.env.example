API_PORT=3004
API_DATA_DIR=.data

# Production: configure distinct, random secrets of at least 32 characters.
# Put API_CUSTOMER_SECRET in the customer app's server environment, and
# API_ADMIN_SECRET in the admin app's server environment. Never NEXT_PUBLIC_.
# API_CUSTOMER_SECRET=
# API_ADMIN_SECRET=
# API_ADMIN_PASSWORD=

# Development generates persistent credentials under .data/ automatically.
# Get the local staff password with: pnpm --filter @0xhq/api admin:password

# Local passport issuance (disabled unconditionally in production).
# The API creates its own local-only signer and initializes the contract during development startup.
PASSPORT_LOCAL_ISSUANCE=true
# Start the public index before any NFT has been issued.
PASSPORT_LOCAL_BOOTSTRAP=true
PASSPORT_RPC_URL=http://127.0.0.1:8545
PASSPORT_IPFS_URL=http://localhost:3003

# Public registry reads use Ponder, independently of the private SQLite database.
PASSPORT_INDEXER_URL=http://127.0.0.1:3005
# Optional absolute manifest path, identical in API and indexer environments.
# PASSPORT_DEPLOYMENTS_FILE=/absolute/path/deployments/local.json
