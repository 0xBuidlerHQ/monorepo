API_PORT=3004
API_DATA_DIR=.data

# Production: configure distinct, random secrets of at least 32 characters.
# Put API_CUSTOMER_SECRET in the customer app's server environment, and
# API_ADMIN_SECRET in the admin app's server environment. Never NEXT_PUBLIC_.
# API_CUSTOMER_SECRET=
# API_ADMIN_SECRET=
# API_ADMIN_PASSWORD=

# Development generates persistent credentials under .data/ automatically.
# Get the local staff password with: pnpm --filter @0xhq/api admin:password
